<Window
    x:Class="ScreenRecorder.Shortcut.ShortcutEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ScreenRecorder.Shortcut"
    xmlns:behaviors="clr-namespace:ScreenRecorder.Behaviors"
    xmlns:properties="clr-namespace:ScreenRecorder.Properties"
    xmlns:theming="clr-namespace:ScreenRecorder.Theming"
    Title="{x:Static properties:Resources.ShortcutSettings}"
    Width="400"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    Background="Transparent"
    FontFamily="{StaticResource AppFontFamily}"
    FontSize="{StaticResource BodyFontSize}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    theming:WindowBackdrop.Kind="Mica"
    >
    <!--  Keyboard-shortcut editor: one row per shortcut, in a small dialog with its own title bar.  -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="36"
            CornerRadius="0"
            GlassFrameThickness="-1"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False"
            />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBackgroundBrush}" behaviors:ClearFocusOnClickBehavior.IsActivated="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Title bar  -->
            <Grid>
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Margin="16,0,0,0"
                    FontSize="12"
                    Text="{x:Static properties:Resources.ShortcutSettings}"
                    />
                <Button
                    Style="{StaticResource CloseIconButtonStyle}"
                    Width="40"
                    Height="28"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Right"
                    FontSize="10"
                    Content="{StaticResource Glyph.Close}"
                    IsCancel="True"
                    Click="CloseButton_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    />
            </Grid>

            <StackPanel Grid.Row="1" Margin="16,2,16,16">
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Margin="1,0,0,10"
                    Text="{x:Static properties:Resources.ShortcutSettingsHint}"
                    TextTrimming="None"
                    TextWrapping="Wrap"
                    />
                <Border Style="{StaticResource CardBorderStyle}" Padding="12,8,10,8">
                    <ItemsControl
                        x:Name="ShortcutList"
                        Focusable="False"
                        Grid.IsSharedSizeScope="True"
                        >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:ShortcutEditor
                                    Margin="0,3"
                                    Title="{Binding DisplayName}"
                                    Shortcut="{Binding}"
                                    />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
