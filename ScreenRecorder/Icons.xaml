<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    >
    <!--
        Icons. Wherever one exists the app uses the system icon font — "Segoe Fluent Icons" on
        Windows 11, falling back to "Segoe MDL2 Assets" on Windows 10, which shares these code
        points (see IconFontFamily in Themes/Controls.xaml). Glyphs are plain strings so they
        can be the Content of any icon button.
    -->
    <sys:String x:Key="Glyph.Settings">&#xE713;</sys:String>
    <sys:String x:Key="Glyph.Folder">&#xE8B7;</sys:String>
    <sys:String x:Key="Glyph.Minimize">&#xE921;</sys:String>
    <sys:String x:Key="Glyph.Close">&#xE8BB;</sys:String>
    <sys:String x:Key="Glyph.Record">&#xE7C8;</sys:String>
    <sys:String x:Key="Glyph.Pause">&#xE769;</sys:String>
    <sys:String x:Key="Glyph.Stop">&#xE71A;</sys:String>
    <sys:String x:Key="Glyph.Region">&#xE7A8;</sys:String>
    <sys:String x:Key="Glyph.Show">&#xE890;</sys:String>
    <sys:String x:Key="Glyph.Hide">&#xED1A;</sys:String>
    <sys:String x:Key="Glyph.Keyboard">&#xE92E;</sys:String>
    <sys:String x:Key="Glyph.Windows">&#xE7C4;</sys:String>
    <sys:String x:Key="Glyph.Microphone">&#xE720;</sys:String>
    <sys:String x:Key="Glyph.MicrophoneOff">&#xF781;</sys:String>
    <sys:String x:Key="Glyph.ChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="Glyph.ChevronUp">&#xE70E;</sys:String>
    <sys:String x:Key="Glyph.Warning">&#xE7BA;</sys:String>
    <sys:String x:Key="Glyph.Error">&#xEA39;</sys:String>
    <sys:String x:Key="Glyph.Completed">&#xE930;</sys:String>
    <sys:String x:Key="Glyph.Delete">&#xE711;</sys:String>

    <!--
        The three capture modes of the on-screen selector have no good system glyph, so they are
        drawn as paths (from https://materialdesignicons.com, Apache-2.0 / MIT). They take the
        foreground of the button they sit in.
    -->
    <Style x:Key="IconPathStyle" TargetType="{x:Type Path}">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}}" />
    </Style>

    <Path
        x:Key="Icon_Region"
        x:Shared="False"
        Style="{StaticResource IconPathStyle}"
        Data="M13 19C13 18.7 13 18.3 13.1 18H8V16H6V8H8V6H16V8H18V13.1C18.3 13 18.7 13 19 13C19.3 13 19.7 13 20 13.1V8H22V2H16V4H8V2H2V8H4V16H2V22H8V20H13.1C13 19.7 13 19.3 13 19M18 4H20V6H18V4M4 4H6V6H4V4M6 20H4V18H6V20M20 15V18H23V20H20V23H18V20H15V18H18V15H20Z"
        />
    <Path
        x:Key="Icon_Window"
        x:Shared="False"
        Style="{StaticResource IconPathStyle}"
        Data="M4,4H20V20H4V4M6,8V18H18V8H6Z"
        />
    <Path
        x:Key="Icon_Display"
        x:Shared="False"
        Style="{StaticResource IconPathStyle}"
        Data="M9,6H5V10H7V8H9M19,10H17V12H15V14H19M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2"
        />
</ResourceDictionary>
