<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="po"
    >
    <!--
        Fluent Design color tokens — DARK. Names and values follow the WinUI theme resources
        (TextFillColor*, ControlFillColor*, ...). Styles consume these only through
        DynamicResource, so ThemeManager can swap the whole dictionary at run time.
        The accent brushes (AccentFillColor*, TextOnAccentFillColorPrimaryBrush) are injected
        by ThemeManager from the user's Windows accent color.
    -->

    <!--  Text  -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" po:Freeze="True" />

    <!--  Control fills  -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#15FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#08FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#0BFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#B31E1E1E" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#19000000" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#8BFFFFFF" po:Freeze="True" />

    <!--  Subtle fills (buttons with no resting background)  -->
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF" po:Freeze="True" />

    <!--  Strokes  -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#12FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#18FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#8BFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="#28FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#19000000" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#33000000" po:Freeze="True" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FFFFFFFF" po:Freeze="True" />

    <!--  Surfaces  -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF202020" po:Freeze="True" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF1C1C1C" po:Freeze="True" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF282828" po:Freeze="True" />
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#FF2C2C2C" po:Freeze="True" />
    <!--  Tint laid over the system acrylic material of flyouts.  -->
    <SolidColorBrush x:Key="AcrylicTintFillColorBrush" Color="#402C2C2C" po:Freeze="True" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0DFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#08FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#4C3A3A3A" po:Freeze="True" />
    <SolidColorBrush x:Key="InsetFillColorBrush" Color="#33000000" po:Freeze="True" />
    <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#4D000000" po:Freeze="True" />

    <!--  Status  -->
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFFF99A4" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FF442726" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFFCE100" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#FF433519" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF6CCB5F" po:Freeze="True" />

    <!--  App specific: the recording red  -->
    <SolidColorBrush x:Key="RecordFillColorDefaultBrush" Color="#FFFF4D4F" po:Freeze="True" />
    <SolidColorBrush x:Key="RecordFillColorHoverBrush" Color="#FFFF6B6D" po:Freeze="True" />
    <SolidColorBrush x:Key="RecordFillColorPressedBrush" Color="#FFE03A3C" po:Freeze="True" />

    <!--  Caption close button  -->
    <SolidColorBrush x:Key="CloseButtonHoverBackgroundBrush" Color="#FFC42B1C" po:Freeze="True" />
    <SolidColorBrush x:Key="CloseButtonPressedBackgroundBrush" Color="#E6C42B1C" po:Freeze="True" />
    <SolidColorBrush x:Key="CloseButtonHoverForegroundBrush" Color="#FFFFFFFF" po:Freeze="True" />

</ResourceDictionary>
