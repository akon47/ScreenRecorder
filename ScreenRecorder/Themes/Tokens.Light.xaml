<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="po"
    >
    <!--  Fluent Design color tokens — LIGHT. Same keys as Tokens.Dark.xaml.  -->

    <!--  Text  -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000" po:Freeze="True" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000" po:Freeze="True" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#72000000" po:Freeze="True" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C000000" po:Freeze="True" />

    <!--  Control fills  -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B3FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#80F9F9F9" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4DF9F9F9" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#4DF9F9F9" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#06000000" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#72000000" po:Freeze="True" />

    <!--  Subtle fills  -->
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00000000" po:Freeze="True" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#09000000" po:Freeze="True" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#06000000" po:Freeze="True" />

    <!--  Strokes  -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#0F000000" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#29000000" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#72000000" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="#37000000" po:Freeze="True" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#0F000000" po:Freeze="True" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#0F000000" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#0F000000" po:Freeze="True" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#E4000000" po:Freeze="True" />

    <!--  Surfaces  -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FFF3F3F3" po:Freeze="True" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FFEEEEEE" po:Freeze="True" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FFF9F9F9" po:Freeze="True" />
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#FFF9F9F9" po:Freeze="True" />
    <SolidColorBrush x:Key="AcrylicTintFillColorBrush" Color="#B3FCFCFC" po:Freeze="True" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B3FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#80F6F6F6" po:Freeze="True" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#80FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="InsetFillColorBrush" Color="#0A000000" po:Freeze="True" />
    <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#4D000000" po:Freeze="True" />

    <!--  Status  -->
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFC42B1C" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FFFDE7E9" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FF9D5D00" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#FFFFF4CE" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF0F7B0F" po:Freeze="True" />

    <!--  App specific: the recording red  -->
    <SolidColorBrush x:Key="RecordFillColorDefaultBrush" Color="#FFD13438" po:Freeze="True" />
    <SolidColorBrush x:Key="RecordFillColorHoverBrush" Color="#FFE04A4E" po:Freeze="True" />
    <SolidColorBrush x:Key="RecordFillColorPressedBrush" Color="#FFB72A2E" po:Freeze="True" />

    <!--  Caption close button  -->
    <SolidColorBrush x:Key="CloseButtonHoverBackgroundBrush" Color="#FFC42B1C" po:Freeze="True" />
    <SolidColorBrush x:Key="CloseButtonPressedBackgroundBrush" Color="#E6C42B1C" po:Freeze="True" />
    <SolidColorBrush x:Key="CloseButtonHoverForegroundBrush" Color="#FFFFFFFF" po:Freeze="True" />

</ResourceDictionary>
