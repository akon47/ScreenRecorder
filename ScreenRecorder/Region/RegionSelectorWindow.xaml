<Window
    x:Class="ScreenRecorder.Region.RegionSelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ScreenRecorder.Region"
    xmlns:properties="clr-namespace:ScreenRecorder.Properties"
    Loaded="Window_Loaded"
    Name="root"
    ResizeMode="NoResize"
    RenderOptions.BitmapScalingMode="NearestNeighbor"
    WindowStyle="None"
    AllowsTransparency="True"
    Topmost="True"
    ShowInTaskbar="False"
    WindowStartupLocation="Manual"
    Title=""
    FontFamily="{StaticResource AppFontFamily}"
    FontSize="{StaticResource BodyFontSize}"
    UseLayoutRounding="True"
    >
    <!--
        One selection overlay per monitor (see RegionSelectorSession). The mode bar — area /
        window / display / cancel — slides in at the top of the primary monitor's overlay.
    -->
    <Grid ClipToBounds="True">
        <local:RegionSelector
            x:Name="regionSelector"
            RegionSelected="regionSelector_RegionSelected"
            RegionSelectionMode="{Binding Path=RegionSelectionMode, ElementName=root, Mode=OneWay}"
            />

        <StackPanel
            x:Name="regionMenuRoot"
            Margin="0,14,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            >
            <StackPanel.RenderTransform>
                <TranslateTransform Y="-90" />
            </StackPanel.RenderTransform>
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                BeginTime="0:0:0.12"
                                Duration="0:0:0.22"
                                Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                From="-90"
                                To="0"
                                >
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>

            <!--  Mode bar  -->
            <Grid HorizontalAlignment="Center">
                <Border
                    Background="{DynamicResource AcrylicBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Effect="{StaticResource FlyoutShadowEffect}"
                    />
                <Border
                    Background="{DynamicResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Padding="5"
                    >
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource IconButtonStyle}">
                                <Setter Property="Width" Value="36" />
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Margin" Value="1,0" />
                                <Setter Property="Padding" Value="9,7" />
                            </Style>
                        </StackPanel.Resources>
                        <RadioButton
                            Content="{StaticResource Icon_Region}"
                            IsChecked="{Binding Path=RegionSelectionMode, ElementName=root, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=UserRegion}"
                            ToolTip="{x:Static properties:Resources.CaptureRegion}"
                            />
                        <RadioButton
                            Content="{StaticResource Icon_Window}"
                            IsChecked="{Binding Path=RegionSelectionMode, ElementName=root, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=WindowRegion}"
                            ToolTip="{x:Static properties:Resources.CaptureWindow}"
                            />
                        <RadioButton
                            Content="{StaticResource Icon_Display}"
                            IsChecked="{Binding Path=RegionSelectionMode, ElementName=root, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=DisplayRegion}"
                            ToolTip="{x:Static properties:Resources.CaptureDisplay}"
                            />
                        <Border
                            Width="1"
                            Margin="6,6"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                            />
                        <Button
                            Style="{StaticResource IconButtonStyle}"
                            Width="36"
                            Height="32"
                            FontSize="11"
                            Content="{StaticResource Glyph.Close}"
                            Click="Close_Click"
                            ToolTip="{x:Static properties:Resources.CaptureCancel}"
                            />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  What to do in the current mode  -->
            <Border
                Margin="0,8,0,0"
                Padding="12,5,12,6"
                HorizontalAlignment="Center"
                Background="#E6202020"
                CornerRadius="12"
                >
                <TextBlock Foreground="White">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="{x:Static properties:Resources.HighlightCaptureRegionHint}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=RegionSelectionMode, ElementName=root}" Value="{x:Static local:RegionSelectionMode.WindowRegion}">
                                    <Setter Property="Text" Value="{x:Static properties:Resources.HighlightCaptureWindowHint}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=RegionSelectionMode, ElementName=root}" Value="{x:Static local:RegionSelectionMode.DisplayRegion}">
                                    <Setter Property="Text" Value="{x:Static properties:Resources.HighlightCaptureDisplayHint}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </StackPanel>
    </Grid>
</Window>
