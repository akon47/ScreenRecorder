<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.20348.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ScreenRecorder</RootNamespace>
    <AssemblyName>ScreenRecorder</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <!-- Keep the checked-in Properties\AssemblyInfo.cs (version/ThemeInfo/DPI attrs). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenRecorder.Engine\ScreenRecorder.Engine.csproj" />
  </ItemGroup>

  <!--
    Legacy engine implementation (SharpDX capture, C++/CLI-driven encoder, NAudio audio, the
    free-run VideoClockEvent, and the hand-rolled NotifyPropertyBase) is kept on disk as the
    P1–P3 porting reference but excluded from the build. Command\DelegateCommand.cs and
    CaptureTarget.cs intentionally survive (rebased onto the Engine / CommunityToolkit).
  -->
  <ItemGroup>
    <Compile Remove="DirectX\**\*.cs" />
    <Compile Remove="AudioSource\**\*.cs" />
    <Compile Remove="VideoSource\**\*.cs" />
    <Compile Remove="Encoder\**\*.cs" />
    <Compile Remove="Reactive\**\*.cs" />
    <Compile Remove="VideoClockEvent.cs" />
    <Compile Remove="Properties\Settings.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <None Include="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('LICENSE.txt')" />
  </ItemGroup>

</Project>
