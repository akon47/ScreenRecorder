<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.20348.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ScreenRecorder</RootNamespace>
    <AssemblyName>ScreenRecorder</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <!-- Version is stamped from -p:Version at release (build_setup.bat / release.yml);
         this is the local default. AssemblyInfo.cs keeps only the attributes the SDK
         does not generate (ThemeInfo / DPI / ComVisible). -->
    <Version>3.0.0</Version>
    <!--
      Runtime tuning for a recorder: concurrent (background) GC so collections do not stall the
      capture/encode threads, tiered PGO for the hot paths. Workstation GC (not Server): this is
      a small tool and must stay small in memory.
    -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenRecorder.Engine\ScreenRecorder.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project reach internal helpers. -->
    <InternalsVisibleTo Include="ScreenRecorder.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <None Include="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('LICENSE.txt')" />
  </ItemGroup>

</Project>
