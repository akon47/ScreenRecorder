<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless test harness for the FFmpeg.AutoGen encode/mux core (P1). Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.20348.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <!-- For System.Drawing (saving an extracted capture frame to PNG for visual verification). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- References the engine (which copies the native FFmpeg DLLs next to this exe). -->
    <ProjectReference Include="..\ScreenRecorder.Engine\ScreenRecorder.Engine.csproj" />
  </ItemGroup>

</Project>
