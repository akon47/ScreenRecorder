<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ScreenRecorder.Engine: the headless recording engine (no UI): Windows.Graphics.Capture
    screen/window capture, GPU color conversion, FFmpeg encoding and muxing, WASAPI audio, and
    the GIF writer. The WPF app drives it through ScreenEncoder + RecordingOptions.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.20348.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <RootNamespace>ScreenRecorder</RootNamespace>
    <AssemblyName>ScreenRecorder.Engine</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <!-- System.Windows.Rect (encoder/monitor geometry) needs WPF; Screen enumeration needs WinForms. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct3D 11 / DXGI / shader compile — the SharpDX successor (P2 capture, NV12). -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <!-- Managed FFmpeg bindings — replaces the C++/CLI MediaEncoder (P1 encode/mux). -->
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <!-- WASAPI capture (P3 audio). -->
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the headless test harness drive internal capture/interop types directly. -->
    <InternalsVisibleTo Include="ScreenRecorder.EncoderHarness" />
    <InternalsVisibleTo Include="ScreenRecorder.Tests" />
  </ItemGroup>

  <!--
    Native FFmpeg 8.x shared DLLs (not committed; see Externals\ffmpeg\README.md). Copied next to
    the consuming executable's output so ffmpeg.RootPath = AppContext.BaseDirectory finds them.
    CopyToOutputDirectory items flow transitively to projects that reference this engine.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\Externals\ffmpeg\win-x64\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
